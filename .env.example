# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=aegisone
POSTGRES_HOST=db
POSTGRES_PORT=5432

# FastAPI Backend Settings
PROJECT_NAME="AegisOne"
API_V1_STR="/api/v1"
ENVIRONMENT=development
SEED_DATABASE_ON_STARTUP=true

# CORS Configuration (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:80", "http://127.0.0.1:5173", "http://127.0.0.1:80"]
