# ==============================================================================
# AegisOne Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND (Deploy on Render)
# ------------------------------------------------------------------------------
# Full connection string for Neon PostgreSQL database:
SQLALCHEMY_DATABASE_URI=postgresql://user:password@ep-some-host.us-east-2.aws.neon.tech/neondb?sslmode=require

# Set application mode:
ENVIRONMENT=production
SEED_DATABASE_ON_STARTUP=true

# Allowed CORS origins for the deployed Vercel frontend:
BACKEND_CORS_ORIGINS=["https://aegisone-frontend.vercel.app", "http://localhost:5173"]

# Optional AI Security Copilot completion configuration (if utilizing OpenAI):
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo

# ------------------------------------------------------------------------------
# FRONTEND (Deploy on Vercel)
# ------------------------------------------------------------------------------
# Deployed Render Backend API base URL:
VITE_API_URL=https://aegisone-backend.onrender.com/api/v1
